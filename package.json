{
  "name": "@mohin4/design-system",
  "version": "0.0.8",
  "description": "AppsCode design system: Tailwind CSS v4 theme and Vue 3 components.",
  "type": "module",
  "files": [
    "dist/lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./editor": {
      "types": "./dist/lib/editor/index.d.ts",
      "import": "./dist/lib/editor/index.js"
    },
    "./theme.css": "./dist/lib/theme.css",
    "./compat.css": "./dist/lib/compat.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run meta && vite",
    "build": "npm run meta && vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "meta": "node scripts/gen-meta.mjs",
    "build:lib": "vite build -c vite.lib.config.ts && vue-tsc -p tsconfig.lib.json && node scripts/copy-theme.mjs && node scripts/build-compat.mjs",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "lucide-vue-next": "^1.0.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.11",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11"
  }
}
